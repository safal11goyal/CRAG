# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to '.env' and fill in your actual credentials before running:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Required API Keys
# ------------------------------------------------------------------------------
# Google Gemini API Key (Get from: https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Cohere API Key for embeddings (Get from: https://dashboard.cohere.com/)
COHERE_API_KEY=your_cohere_api_key_here

# Pinecone Vector Database API Key (Get from: https://app.pinecone.io/)
PINECONE_API_KEY=your_pinecone_api_key_here

# ------------------------------------------------------------------------------
# 2. Optional Fallback Search API Key
# ------------------------------------------------------------------------------
# Tavily API Key for web search fallback when document context is insufficient (Get from: https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 3. Model Configurations
# ------------------------------------------------------------------------------
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=embed-english-v3.0

# ------------------------------------------------------------------------------
# 4. Chunking & Retrieval Parameters
# ------------------------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4
MAX_ITERATIONS=3

# ------------------------------------------------------------------------------
# 5. Pinecone Vector Database Configuration
# ------------------------------------------------------------------------------
PINECONE_INDEX_NAME=rag-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ------------------------------------------------------------------------------
# 6. PostgreSQL Database Configuration (Session & Chat History Persistence)
# ------------------------------------------------------------------------------
# Option A: Full Connection URI (Supabase, Neon, or standard PostgreSQL) - takes priority if set:
DATABASE_URL=postgresql://postgres:password@localhost:5432/rag_db

# Option B: Fallback individual variables (used when DATABASE_URL is empty):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=rag_db

# ------------------------------------------------------------------------------
# 7. Local Directories
# ------------------------------------------------------------------------------
DOCUMENTS_DIR=documents
VECTORSTORE_DIR=vectorstore

# ------------------------------------------------------------------------------
# 8. LangSmith Observability & Tracing (Optional)
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=RAG
