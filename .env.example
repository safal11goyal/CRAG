# ==========================================
# Google Gemini API Key
# ==========================================
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# ==========================================
# Cohere Embedding API Key
# ==========================================
COHERE_API_KEY=your_cohere_api_key_here
EMBEDDING_MODEL=embed-english-v3.0

# ==========================================
# Tavily Web Search API Key (Fallback)
# ==========================================
TAVILY_API_KEY=your_tavily_api_key_here

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
# Option 1: Full Connection URL (Neon, Supabase, Render, local Docker, etc.)
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/rag_db
DATABASE_URL=

# Option 2: Individual Connection Parameters
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=rag_db

# ==========================================
# RAG Chunking & Retrieval Parameters
# ==========================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4
MAX_ITERATIONS=3
DOCUMENTS_DIR=documents
VECTORSTORE_DIR=vectorstore
